# ==========================================
# Whauto AI — variables d'environnement (dev)
# Copier en .env et ajuster si besoin.
# Aucune valeur ci-dessous n'est un secret réel.
# ==========================================

NODE_ENV=development
LOG_LEVEL=info

# --- apps/api ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://whauto:whauto@localhost:5433/whauto_dev
REDIS_URL=redis://localhost:6379

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- apps/whatsapp-worker ---
# réutilise DATABASE_URL et REDIS_URL ci-dessus

# --- apps/api : auth (JWT access token) ---
# Secret de dev uniquement — jamais réutiliser en production. Générer avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-please-32chars-min
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# --- apps/api : auth (cookie du refresh token) ---
COOKIE_NAME=whauto_refresh
# COOKIE_DOMAIN volontairement absent : cookie host-only par défaut (voir CLAUDE.md)
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# --- apps/api : auth (liens frontend / email) ---
APP_WEB_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@whauto.ai
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24

# --- apps/api : organizations (invitations) ---
INVITATION_EXPIRES_IN_DAYS=7

# --- apps/api : auth (dev uniquement) ---
# Expose le lien de vérification/reset dans la réponse HTTP en plus des logs console.
# Sans effet si NODE_ENV != development, quelle que soit cette valeur.
AUTH_EXPOSE_TEST_TOKENS=true

# --- apps/api : auth (rate limiting — MAX requêtes par WINDOW_SECONDS) ---
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER_MAX=3
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_RESET_MAX=3
AUTH_RATE_LIMIT_RESET_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REFRESH_MAX=20
AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_FORGOT_PASSWORD_MAX=3
AUTH_RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_RESEND_VERIFICATION_MAX=3
AUTH_RATE_LIMIT_RESEND_VERIFICATION_WINDOW_SECONDS=60

# --- apps/api + apps/whatsapp-worker : WhatsApp (module conversationnel) ---
# Endpoints de simulation POST /api/dev/whatsapp/mock/* — dev/test uniquement.
# Zod REFUSE true en production ; le module n'est alors même pas enregistré.
ENABLE_MOCK_WHATSAPP_ENDPOINTS=true
# Jobs BullMQ (noms de queues = constantes @whauto/shared, pas des variables).
WHATSAPP_JOB_ATTEMPTS=3
WHATSAPP_JOB_BACKOFF_MS=2000
# Provider MOCK : délais simulés avant DELIVERED puis READ (worker).
WHATSAPP_MOCK_DELIVERY_DELAY_MS=1500
WHATSAPP_MOCK_READ_DELAY_MS=2000
# Sweeps de récupération (durable inbox + outbox) du worker.
WHATSAPP_RECOVERY_SWEEP_INTERVAL_MS=30000
WHATSAPP_RECOVERY_STALENESS_MS=60000
# Statut orphelin (providerMessageId encore inconnu) : au-delà de ce délai en
# WAITING_MESSAGE, l'événement devient ORPHANED (worker).
WHATSAPP_ORPHAN_STATUS_TTL_MS=300000

# --- docker-compose (Postgres) ---
POSTGRES_USER=whauto
POSTGRES_PASSWORD=whauto
POSTGRES_DB=whauto_dev

# --- Panier conversationnel (Cart + réservations + checkout) ---
CART_INACTIVITY_TTL_MINUTES=120
STOCK_RESERVATION_TTL_MINUTES=15
STOCK_RESERVATION_MAX_LIFETIME_MINUTES=60
STOCK_RESERVATION_RENEWAL_MIN_INTERVAL_SECONDS=60
CART_EXPIRATION_SWEEP_INTERVAL_SECONDS=30

# --- apps/api + apps/whatsapp-worker : Meta WhatsApp Cloud API ---
# TOUTES ces valeurs sont VIDES/FACTICES ici : les vrais secrets vivent
# uniquement dans .env (jamais commité). Optionnels — sans eux, le provider
# MOCK continue de fonctionner. Ne jamais mettre de secret réel dans ce fichier.
META_APP_ID=

META_APP_SECRET=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Base de l'API Graph — surchargeable pour pointer un faux serveur Graph en test.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_REQUEST_TIMEOUT_MS=30000

# --- Google Gemini / IA (sous-phases B et C — non actives en sous-phase A) ---
# GEMINI_API_KEY vit UNIQUEMENT dans .env, jamais ici, jamais NEXT_PUBLIC_.
AI_PROVIDER=MOCK
AI_MODE=SUGGEST_ONLY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Surchargée par les tests pour pointer un faux serveur Gemini local
# (le VRAI provider est alors exercé, sans jamais appeler Google).
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
AI_MAX_OUTPUT_TOKENS=300
AI_CONTEXT_MAX_MESSAGES=50
AI_TOOL_MAX_ROUNDS=4
AI_REQUEST_TIMEOUT_MS=30000
# Regroupe plusieurs messages clients rapprochés en UN seul run IA.
AI_DEBOUNCE_MS=3000
# --- Paiement SaaS (recharge de crédits) ---
PAYMENT_PROVIDER=MOCK
ALLOW_MOCK_PAYMENTS=false
# Genius Pay (futur) — laisser vide ; les vrais secrets ne vivent QUE dans .env (jamais ici)
GENIUS_PAY_API_BASE_URL=
GENIUS_PAY_API_KEY=
GENIUS_PAY_SECRET_KEY=
GENIUS_PAY_WEBHOOK_SECRET=
GENIUS_PAY_MERCHANT_ID=
GENIUS_PAY_RETURN_URL=
GENIUS_PAY_CANCEL_URL=
